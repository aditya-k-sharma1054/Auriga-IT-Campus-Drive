{
  "name": "parkops",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @parkops/api\" \"npm run dev --workspace @parkops/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "db:generate": "npm run db:generate --workspace @parkops/api",
    "db:migrate": "npm run db:migrate --workspace @parkops/api",
    "db:push": "npm run db:push --workspace @parkops/api",
    "db:init": "node scripts/init-sqlite.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
